     :status "RAT" :case :token
     :step-text ":alice should see the title {orderNumber}"}
    {:example "should see title Welcome"
     :status "RAT" :case :bare-reserved
     :step-text ":alice should see the title Welcome"}]}
  :matcher-slot
  {:wiki-heading "Matcher slot"
   :rows
   [{:example "captures El matching /Order (?<orderNumber>[A-Z0-9-]+)/"
     :status "RAT" :case :capture-named-binds
     :step-text ":alice captures {:id \"order\"} matching /Order (?<orderNumber>[A-Z0-9-]+)/"}
    {:example "captures El matching /Order [A-Z0-9-]+/ (all-unnamed)"
     :status "RAT" :case :capture-all-unnamed-error
     :step-text ":alice captures {:id \"order\"} matching /Order ([A-Z0-9-]+)/"}
    {:example "should see El matching /Order [A-Z0-9-]+/"
     :status "RAT" :case :assert-only-silent
     :step-text ":alice should see {:id \"order\"} matching /Order ([A-Z0-9-]+)/"}
    {:example "should see El matching /(?<code>\\d+)/"
     :status "RAT" :case :assert-only-named-error
     :step-text ":alice should see {:id \"order\"} matching /(?<code>\\d+)/"}
    {:example "receives … matching /code (\\d+)/ (SMS, all-unnamed)"
     :status "RAT" :case :receives-unnamed-notice
     :step-text ":alice receives an SMS to '+15550001111' matching /code (\\d+)/"}
    {:example "… matching /code (?<c>\\d+) was {prev}/"
     :status "RAT" :case :embedded-token-consumes
     :step-text ":alice captures {:id \"m\"} matching /code (?<c>\\d+) was {prev}/"}
    {:example "… matching /Order (?<c>[/"
     :status "RAT" :case :malformed-pattern-error
     :step-text ":alice captures {:id \"m\"} matching /Order (?<c>[/"}]}

  :key-slot
  {:wiki-heading "Key slot"
   :rows
   [{:example "presses Enter"
     :status "RAT" :case :w3c-name
     :step-text ":alice presses Enter"}
    {:example "presses Entr"
     :status "RAT" :case :typo
     :step-text ":alice presses Entr"
     :suggestion :Enter}
    {:example "presses 'g'"
     :status "RAT" :case :quoted-single
     :step-text ":alice presses 'g'"
     :key-sent "g"}
    {:example "presses 'abc'"
     :status "RAT" :case :quoted-multi
