;; every checkout, CI included); grammar_table_test's wiki-sync drift test
;; compares it against the wiki file when _docs resolves and self-skips
;; when it doesn't (bare CI checkout). Update BOTH when the law changes.
;;
;; :example/:status mirror the wiki table cells (backticks stripped).
;; :case keys the behavioral assertion in grammar_table_test.

{:source "_docs/wiki/decisions/grammar-markers.md"
 :sections
 {:element-slot
  {:wiki-heading "Element slot"
   :rows
   [{:example "fills Login.code with '123456'"
     :status "RAT" :case :ref-resolves
     :step-text ":alice fills Login.code with '123456'"}
    {:example "fills Login.cdoe with 'x'"
     :status "RAT" :case :typo-ref-matches
     :step-text ":alice fills Login.cdoe with 'x'"}
    {:example "fills 'Login.code' with 'x'"
     :status "RAT (surface confirmed 2026-07-22: undefined-step diagnostic; hints = sl-s04n); hints landed sl-s04n"
     :case :quoted-ref-hint
     :step-text ":alice fills 'Login.code' with 'x'"
     :repaired ":alice fills Login.code with 'x'"}]}

  :value-slot
  {:wiki-heading "Value slot"
   :rows
   [{:example "fills Login.code with {code}"
     :status "RAT" :case :value-token
     :step-text ":alice fills Login.code with {code}"}
    {:example "(no producer)"
     :status "RAT" :case :token-no-producer
     :step-text ":alice fills Login.code with {code}"}
    {:example "fills Login.code with '{code}'"
     :status "RAT" :case :quoted-token-literal
     :step-text ":alice fills Login.code with '{code}'"
     :normalized "{code}"}
    {:example "fills Login.code with 'say \"hi\"'"
     :status "RAT" :case :double-quote-inside-literal
     :step-text ":alice fills Login.code with 'say \"hi\"'"
     :normalized "say \"hi\""}
    {:example "fills Login.code with \"x\""
     :status "RAT" :case :double-quotes-hint
     :step-text ":alice fills Login.code with \"x\""
     :repaired ":alice fills Login.code with 'x'"}
    {:example "fills Login.code with 'x"
     :status "RAT" :case :unbalanced-quote-hint
     :step-text ":alice fills Login.code with 'x"
     :repaired ":alice fills Login.code with 'x'"}
    {:example "fills Login.code with ''"
     :status "RAT; hint points at clears (sl-s04n)" :case :empty-literal
     :step-text ":alice fills Login.code with ''"}
    {:example "… with {order-number}"
     :status "RAT" :case :hyphen-token
     :step-text ":alice fills Login.code with {order-number}"}
    {:example "… with {OrderNumber}"
     :status "RAT" :case :uppercase-token
     :step-text ":alice fills Login.code with {OrderNumber}"}
    {:example "… with Welcome"
     :status "RAT" :case :bare-value-reserved
     :step-text ":alice fills Login.code with Welcome"}]}

  :location-slot
  {:wiki-heading "Location slots"
   :rows
   [{:example "opens the browser to Login"
     :status "RAT" :case :named-ref-navigate
     :step-text ":alice opens the browser to Login"}
    {:example "should be on Widget (intent exists, no :location)"
     :status "RAT" :case :no-location-ref
     :step-text ":alice should be on Widget"}
    {:example "opens the browser to '/login'"
     :status "RAT (A5, landed sl-34ec)" :case :nav-root-relative
     :step-text ":alice opens the browser to '/login'"
     :literal "/login"
     :resolved "http://h:9092/login"}
    {:example "opens the browser to 'Login'"
     :status "RAT (A5, landed sl-34ec)" :case :nav-bare-word-literal
     :step-text ":alice opens the browser to 'Login'"
     :literal "Login"
     :resolved "http://h:9092/Login"}
    {:example "opens the browser to {resetLink}"
     :status "RAT" :case :nav-token
     :step-text ":alice opens the browser to {resetLink}"}
    {:example "should be on Feed / should be on exactly Dashboard.home"
     :status "RAT" :case :region-ref-exactly-reserved
     :step-text ":alice should be on Feed"
     :reserved-text ":alice should be on exactly Dashboard.home"}
    {:example "should be on exactly '{myUrl}'"
     :status "RAT" :case :exactly-quoted-token
     :step-text ":alice should be on exactly '{myUrl}'"}
    {:example "should be on exactly 'Login'"
     :status "RAT (amended A5; was unconditional :not-a-full-url)"
     :case :exactly-bare-word
     :step-text ":alice should be on exactly 'Login'"
     :literal "Login"
     :resolved "http://h:9092/Login"}]}

  :text-slot
  {:wiki-heading "Text slot"
   :rows
   [{:example "should see title 'Welcome'"
     :status "RAT" :case :quoted-literal
     :step-text ":alice should see the title 'Welcome'"
     :normalized "Welcome"}
    {:example "should see title 'Dashboard.home'"
     :status "RAT" :case :ref-shaped-literal
     :step-text ":alice should see the title 'Dashboard.home'"
     :normalized "Dashboard.home"}
