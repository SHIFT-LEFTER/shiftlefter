;; ShiftLefter configuration
;; Copy to sl/shiftlefter.edn (the only discovered location) and customize.
;; Config-declared paths resolve from the config's directory, so the
;; defaults below land at sl/steps/ and sl/features/.

{:parser {:dialect "en"}       ;; Language dialect (en, fr, de, etc.)

 :runner {:step-paths ["steps/"]      ;; Where to find step definitions
          :features ["features/"]     ;; Feature corpus for bare `sl run`
          :allow-pending? false       ;; Exit 0 even with pending steps?
          ;; Capture artifacts into the run's results dir (sl/results/<stamp>/).
          ;; Kinds: :screenshot :console :page-source (browser); policies:
          ;; :never (default) | :on-failure | :every-step. Recommended:
          ;; :capture {:screenshot :on-failure
          ;;           :console :on-failure}
          }

 ;; --- Timing (the deadline substrate) ---
 ;; How long oracle steps (should-see, waits-for, receive) poll before a
 ;; legible timeout, and how often they poll. Unset = per-class defaults
 ;; (browser verify 3s/100ms, :wait frames 5s/100ms, SMS receive 30s/500ms,
 ;; custom poll-until 30s/500ms). Resolution: interface-entry :timing >
 ;; this global map > defaults; every timeout report names the rung that
 ;; decided it. Mutations never retry; this budget is oracles-only.
 ;;
 ;; :timing {:deadline-ms 30000 :interval-ms 500}
 ;;
 ;; Per-interface override — a :timing sibling on any :interfaces entry
 ;; (:web :default keeps the builtin browser instance — writing :interfaces
 ;; makes your map the COMPLETE set, see below):
 ;; :interfaces {:web :default
 ;;              :sms {:type :sms :adapter :twilio
 ;;                    :timing {:deadline-ms 60000}}}

 ;; --- Vocabulary and enforcement ---
 ;; Every scenario is validated against the project glossary at planning
 ;; time, before anything runs — there is no mode to turn on. The
 ;; :enforcement block below holds nothing but levels; leaving it out means
 ;; the defaults (:unknown-subject/:unknown-verb :warn, :unknown-interface
 ;; :error). Uncomment to tighten. `sl orient --edn` shows the effective levels.
 ;; See docs/SVO.md for the glossary file formats.
 ;;
 ;; Glossaries at the conventional paths next to this config —
 ;; glossary/subjects.edn, glossary/verbs/<type>.edn, glossary/intents/ —
 ;; are discovered automatically; an explicit :glossaries map overrides
 ;; them wholesale (:glossaries nil turns them off).
 ;;
 ;; Writing :interfaces replaces the builtin set WHOLESALE (no :interfaces
 ;; key = builtin defaults; :web :default = the builtin def verbatim; a full
 ;; map is used as-is under any name and must declare its :type):
 ;; :interfaces {:web {:type :web :adapter :etaoin}}   ; bundled WebDriver backend
 ;; :enforcement {:unknown-subject :error
 ;;               :unknown-verb    :warn
 ;;               :unknown-interface :error}
 }
