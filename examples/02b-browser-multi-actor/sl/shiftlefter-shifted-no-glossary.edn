;; Teaching config — enforcement WITHOUT a glossary: :unknown-subject is
;; a hard error but no subjects are declared, so every step is rejected at
;; planning time. Demonstrates that the glossary is the source of truth.
;; :glossaries nil is EXPLICIT here (sl-fcjm): an absent key would pick up
;; the conventional glossary/ files sitting next to this config; explicit
;; nil means "no glossaries, on purpose".
;; Run with: sl run -c sl/shiftlefter-shifted-no-glossary.edn --dry-run sl/features/

{:interfaces {:web {:type :web
                    :adapter :etaoin}}
 :glossaries nil
 :enforcement {:unknown-subject :error}}
